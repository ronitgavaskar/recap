GITHUB_TOKEN=
GITHUB_USERNAME=
ANTHROPIC_API_KEY=

# AWS (required for Lambda deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
LAMBDA_ROLE_ARN=

# SES email delivery (optional — if both are set, Lambda will email standups)
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=

# Slack (optional — create an incoming webhook at https://api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
